+  // Les deux groupes d'onglets se parcourent comme un contrôle segmenté : un seul arrêt de Tab, puis les flèches.
+  document.querySelectorAll('[role=tablist]').forEach(function (list) {
+    var tabs = [].slice.call(list.querySelectorAll('[role=tab]'));
+    function sync() { tabs.forEach(function (t) { t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1; }); }
+    sync();
+    list.addEventListener('click', function () { setTimeout(sync); });
+    list.addEventListener('keydown', function (e) {
+      var i = tabs.indexOf(document.activeElement); if (i < 0) return;
+      var j = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
+      if (j === undefined) return;
+      e.preventDefault();
+      var t = tabs[(j + tabs.length) % tabs.length]; t.click(); t.focus();
+    });
+  });
