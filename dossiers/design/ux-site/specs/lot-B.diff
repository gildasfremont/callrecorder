+<script>
+  // Hors d'un Mac, la ligne et les étapes ne servent à rien : on propose d'envoyer le lien de la page.
+  (function () {
+    var ua = navigator.userAgent, mac = /Macintosh/.test(ua) && navigator.maxTouchPoints < 2;
+    if (mac) return;
+    var box = document.querySelector('.install'); box.classList.add('hors-mac');
+    var url = location.origin + location.pathname;
+    box.querySelector('[data-partage]').addEventListener('click', function () {
+      if (navigator.share) navigator.share({ title: 'Callrecorder', url: url }).catch(function () {});
+      else location.href = 'mailto:?subject=' + encodeURIComponent('Callrecorder') + '&body=' + encodeURIComponent(url);
+    });
+  })();
